{
  "xidlc.package": {
    "prefix": "#pragma package",
    "body": "#pragma xidlc package ${1:name}",
    "description": "Set the XIDL package name"
  },
  "xidlc.version": {
    "prefix": "#pragma version",
    "body": "#pragma xidlc version ${1:version}",
    "description": "Set the XIDL package version"
  },
  "xidlc.service": {
    "prefix": "#pragma service",
    "body": "#pragma xidlc service ${1:url} ${2:name}",
    "description": "Declare an XIDL service"
  }
}
