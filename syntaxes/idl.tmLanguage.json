{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IDL",
  "scopeName": "source.idl",
  "patterns": [
    {
      "include": "#preprocessor"
    },
    {
      "include": "#extended-annotations"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#member-names"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "preprocessor": {
      "patterns": [
        {
          "begin": "^\\s*(#\\s*include)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.directive.idl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "match": "\"[^\"]*\"",
              "name": "string.quoted.other.idl"
            },
            {
              "match": "<[^>]*>",
              "name": "string.quoted.other.idl"
            },
            {
              "match": "[a-zA-Z_][a-zA-Z0-9_./]*",
              "name": "string.quoted.other.idl"
            }
          ]
        },
        {
          "match": "^\\s*(#\\s*[a-zA-Z0-9_]+)",
          "captures": {
            "1": {
              "name": "keyword.directive.idl"
            }
          }
        }
      ]
    },
    "extended-annotations": {
      "match": "//@[^\\n]*",
      "name": "meta.attribute.idl"
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.idl"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.idl"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "L?\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.idl"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.idl"
            }
          },
          "name": "string.quoted.double.idl",
          "patterns": [
            {
              "match": "\\\\(?:x[0-9a-fA-F]+|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3}|.)",
              "name": "constant.character.escape.idl"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "begin": "L?'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.idl"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.idl"
            }
          },
          "name": "string.quoted.single.idl",
          "patterns": [
            {
              "match": "\\\\(?:x[0-9a-fA-F]+|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3}|.)",
              "name": "constant.character.escape.idl"
            }
          ]
        }
      ]
    },
    "numbers": {
      "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|\\d+\\.\\d+[dD]|\\d+\\.\\d+(?:[eE][+-]?\\d+)?|\\d+)\\b",
      "name": "constant.numeric.idl"
    },
    "booleans": {
      "match": "\\b(TRUE|FALSE)\\b",
      "name": "constant.language.idl"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(local|abstract|custom)\\s+(interface|valuetype)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.idl"
            },
            "2": {
              "name": "storage.type.idl"
            },
            "3": {
              "name": "entity.name.type.idl"
            }
          }
        },
        {
          "match": "\\b(struct|union|enum|interface|valuetype|exception|module|component|eventtype|porttype|connector|home|bitset|bitmask|native)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.idl"
            },
            "2": {
              "name": "entity.name.type.idl"
            }
          }
        },
        {
          "match": "(@annotation)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.idl"
            },
            "2": {
              "name": "entity.name.type.idl"
            }
          }
        },
        {
          "match": "\\b(factory)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.idl"
            },
            "2": {
              "name": "entity.name.type.idl"
            }
          }
        },
        {
          "begin": "\\b(typedef)\\b",
          "beginCaptures": {
            "1": {
              "name": "storage.type.idl"
            }
          },
          "end": ";",
          "endCaptures": {
            "0": {
              "name": "punctuation.delimiter.idl"
            }
          },
          "patterns": [
            {
              "include": "#builtin-types"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#attributes"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            },
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*(?:,|;))",
              "captures": {
                "1": {
                  "name": "entity.name.type.idl"
                }
              }
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(switch|case|default|raises|getraises|setraises)\\b",
          "name": "keyword.control.idl"
        },
        {
          "match": "\\bimport\\b",
          "name": "keyword.directive.idl"
        },
        {
          "match": "\\b(struct|union|enum|interface|valuetype|exception|typedef|bitmask|bitset|component|porttype|connector|eventtype|home|module|native|typeid|typeprefix)\\b",
          "name": "storage.type.idl"
        },
        {
          "match": "\\b(const|readonly|abstract|local|custom|oneway|in|out|inout|context|public|private|truncatable|multiple|bitfield|typename|alias)\\b",
          "name": "storage.modifier.idl"
        },
        {
          "match": "\\b(port|attribute|factory|finder|provides|uses|emits|publishes|consumes|primarykey|supports|manages)\\b(?!\\s*[;,)]|\\s*$)",
          "name": "storage.modifier.idl"
        }
      ]
    },
    "builtin-types": {
      "match": "\\b(unsigned long long|unsigned long|unsigned short|long long|long double|unsigned|long|short|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|double|char|wchar|boolean|octet|fixed|string|wstring|sequence|map|any|Object|ValueBase|void)\\b",
      "name": "support.type.primitive.idl"
    },
    "constants": {
      "match": "\\b[A-Z][A-Z0-9_]+\\b",
      "name": "constant.other.idl"
    },
    "attributes": {
      "match": "(@)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "meta.attribute.idl"
        },
        "2": {
          "name": "support.type.annotation.idl"
        }
      }
    },
    "functions": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.idl"
        }
      }
    },
    "member-names": {
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=;)",
      "captures": {
        "1": {
          "name": "variable.other.member.idl"
        }
      }
    },
    "operators": {
      "match": "<<|>>|[-+*/%=~|^&]",
      "name": "keyword.operator.idl"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}()\\[\\]<>]",
          "name": "punctuation.bracket.idl"
        },
        {
          "match": "::|;|:|,",
          "name": "punctuation.delimiter.idl"
        }
      ]
    }
  }
}
